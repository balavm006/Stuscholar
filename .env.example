# ──────────────────────────────────────────────────────────────
# TN StuScholar — Appwrite environment configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# Appwrite API endpoint (use Appwrite Cloud or your self-hosted URL)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID  (Dashboard → Settings → Project ID)
APPWRITE_PROJECT_ID=your_project_id

# Server API Key with Database read+write scope
# (Dashboard → Settings → API Keys → Add API Key)
APPWRITE_API_KEY=your_server_api_key
# The Database ID you created in Appwrite
# (Databases → Create Database → copy the Database ID)
APPWRITE_DATABASE_ID=your_database_id

# Collection IDs (must match what you created in Appwrite)
APPWRITE_USERS_COLLECTION=users
APPWRITE_TOKENS_COLLECTION=tokens
APPWRITE_APPS_COLLECTION=applications
